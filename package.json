    "autoprefixer": "^10.6.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
