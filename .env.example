DATABASE_URL="postgresql://gdbs:gdbs@127.0.0.1:54329/gdbs_lims"
SESSION_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Optional. Sends verification and password-reset emails through Resend.
# Without these, development shows the links on screen and production sends nothing.
# onboarding@resend.dev is Resend's sandbox and can only deliver to the Resend account email.
# After a GDBS domain is verified in Resend, change EMAIL_FROM to that domain.
RESEND_API_KEY=""
EMAIL_FROM="Grenada Bureau of Standards <onboarding@resend.dev>"

# Set on Vercel by the Blob integration. Without it, files are kept in storage/.
BLOB_READ_WRITE_TOKEN=""

# Optional. Creates the first administrator when you run npm run staff:create.
# Staff registration is not available on the public site.
STAFF_BOOTSTRAP_EMAIL=""
STAFF_BOOTSTRAP_PASSWORD=""
STAFF_BOOTSTRAP_NAME=""
